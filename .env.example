# Copy to .env and replace BOTH occurrences of replace_me with the same
# randomly generated URL-safe database password. Never commit .env.
POSTGRES_USER=bestapp
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=bestapp
DATABASE_URL=postgresql+psycopg://bestapp:replace_me@localhost:5432/bestapp

# Optional for Compose provisioning; otherwise it prompts securely.
# Local Python provisioning reads this from the process environment instead.
# BESTAPP_DEMO_PASSWORD=

# Bounded database waits (seconds, except the query timeout in milliseconds).
DB_CONNECT_TIMEOUT=3
DB_QUERY_TIMEOUT_MS=2000
DB_POOL_TIMEOUT=3
